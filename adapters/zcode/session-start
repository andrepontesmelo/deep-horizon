#!/bin/sh
# adapters/zcode/session-start — ZCode SessionStart hook (deep-horizon adapter).
# POSIX sh + jq. Reads the hook's stdin JSON and, for fresh startups of a
# project with a horizon store, emits the composed block in the envelope ZCode
# injects into the session. Fail-open everywhere: any error, missing tool, or
# missing bin exits 0 with no output — a hook must never block a session.
#
# Output path, PROVEN against the harness bundle
# (/home/andre/.npm-global/lib/node_modules/zcode-app-cli/vendor/zcode.cjs,
# ZCode 3.11.2-22): plain stdout is ignored — parseHookStdout (jni) returns
# nothing for output that does not start with "{" — so the
# {"additionalContext": "..."} JSON envelope is REQUIRED. The key must be
# camelCase: the schema also accepts "additional_context", but the output
# mapping (Oni) only reads "additionalContext" into the history entries. The
# schema is strict (any extra key marks the run failed), so exactly one key
# is emitted. Non-zero exits other than 2 have their output discarded, which
# is what makes fail-open free here.
#
# Subagents: the SessionStart stdin payload carries NO subagent discriminator
# (probed the bundle: payload is agentName/cwd/hookEventName/mode/model/
# sessionId/source/timestamp/traceId/turnId; no parent_session_id, no
# task_type). agentName is ambiguous — top-level workflow/expert sessions
# also carry zcode-* names — so a guard on it would misfire, and none is
# built. Whether subagent child sessions run SessionStart hooks at all is
# UNPROVEN in the bundle; if they do, they receive the horizon like a
# top-level session would (noise, not harm — the pi adapter's trade).
#
# Session end (the zcode-only tail): ZCode has no session-close hook (the
# stop-steer probe still stands: Stop fires at the end of EVERY assistant
# turn, not at session close), so the close duty rides this startup
# injection — once the composed text passes the empty check, a tail is
# appended telling the agent to offer `horizon session-end --harness zcode
# --session <id>` when the user is wrapping up. The retired steer's
# once-guards (a record already in sessions.jsonl, a marker file in
# $TMPDIR) are gone because the instruction rides the once-per-session
# startup injection now, which is its own once-guard. The tail fires only
# when a store exists somewhere above the cwd — inherited from the
# non-empty-text check, a storeless composition being empty and exit-silent
# — and only when the payload carries a sessionId: without the id the agent
# cannot name the record, and a placeholder id would write a wrong one.
#
# The param trigger's seed (adapters/zcode/pre-execute reads the same
# marker): ZCode's PreToolUse hook fires on every matching tool call, and
# its dedup lives in a per-session marker file under ${TMPDIR:-/tmp} —
# `d <dir>` records a dir the bin has answered for, `s <store>` a store the
# session has been served. Once the startup injection is real, this hook
# seeds both for the launch dir: the store it resolved counts as served and
# the launch dir as known, so a mid-session touch of the launch repo never
# re-injects the horizon this injection just delivered. That needs the
# store's path, so the bin is asked with --json — the total answer's text
# composes identically to the plain form (the stdout bytes below do not
# move) and the store field rides along for free. The marker is keyed by
# the session id, sanitized before it becomes a filename (same recipe as
# pre-execute). Storeless launches (the bootstrap nudge) seed the dir
# alone — the nudge was delivered here, and a param re-nudge would
# duplicate it. Fail-open: an unwritable TMPDIR costs the seed, never the
# injection (pre-execute then stays silent for the session, its own
# no-memory-no-injection rule).
#
# cwd: the hook process runs in the session's working directory (probed:
# executionPort.run({cwd: payload.cwd || getWorkingDirectory()})), and
# ZCODE_PROJECT_DIR env carries the same path, so the store resolves the way
# `horizon` resolves it. The stdin cwd wins, then ZCODE_PROJECT_DIR, then the
# process cwd.
set -u

payload=$(cat 2>/dev/null) || exit 0
[ -n "$payload" ] || exit 0

# Fresh startups only ("startup" is the first turn of a session-manager
# instance; "resume" fires after --resume, and a resumed session replays the
# original injection from its persisted history — re-injecting would
# duplicate it). The docs' "clear"/"compact" sources never appear in this
# build's call sites, so the negative match covers them for free.
source=$(printf '%s' "$payload" | jq -r '.source // empty' 2>/dev/null) || exit 0
[ "$source" = "startup" ] || exit 0

cwd=$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null) || exit 0
[ -n "$cwd" ] || cwd=${ZCODE_PROJECT_DIR:-}
[ -n "$cwd" ] || cwd=$(pwd)

# Bin resolution (hermes pattern): an installed package uses the global bin
# on PATH; a repo checkout runs bin/horizon-inject.js with node, because the
# bare bins are not linked yet — the bin is a shim onto the built dist, so
# the checkout needs its build step (npm install / npm run build) first; a
# missing build fails open with no text below.
here=$(cd "$(dirname "$0")" 2>/dev/null && pwd) || exit 0
if command -v horizon-inject >/dev/null 2>&1; then
  answer=$(horizon-inject --harness zcode --json --cwd "$cwd" 2>/dev/null)
elif command -v node >/dev/null 2>&1 && [ -f "$here/../../bin/horizon-inject.js" ]; then
  answer=$(node "$here/../../bin/horizon-inject.js" --harness zcode --json --cwd "$cwd" 2>/dev/null)
else
  exit 0
fi

# The --json answer is the total shape the DSH adapter parses: {"text":
# string, "store": string|null}. The text composes identically to the plain
# form; the store is the marker seed's reason for --json (see the header).
# Anything off-shape fails open: no text, no injection.
text=$(printf '%s' "$answer" | jq -r 'if type=="object" and (.text|type=="string") then .text else empty end' 2>/dev/null) || exit 0
store=$(printf '%s' "$answer" | jq -r 'if type=="object" and (.store|type=="string") then .store else empty end' 2>/dev/null) || store=""

# Empty composition = nothing to inject (a storeless $HOME stays silent).
[ -n "$text" ] || exit 0

# The session-end tail names the record the agent is to close, so it needs
# the session id from the payload; absent or empty, the horizon injects
# alone. The id comes off the harness's own payload (camelCase, see the
# shape above).
sid=$(printf '%s' "$payload" | jq -r '.sessionId // empty' 2>/dev/null) || exit 0

# The marker seed (see the header): only once the injection is real — the
# empty-text exit above — and only with a session id to key it on. The
# appends fail open: an unwritable marker costs the seed, never this
# injection.
if [ -n "$sid" ]; then
  safe=$(printf '%s' "$sid" | tr -c 'A-Za-z0-9._-' '_' 2>/dev/null) || safe=""
  if [ -n "$safe" ]; then
    marker=${TMPDIR:-/tmp}/horizon-zcode-$safe
    printf 'd %s\n' "$cwd" >>"$marker" 2>/dev/null
    [ -n "$store" ] && printf 's %s\n' "$store" >>"$marker" 2>/dev/null
  fi
fi

if [ -n "$sid" ]; then
  text="$text

One more duty, ZCode-only: this harness has no session-close hook, so the
session record is yours to close. When the user is wrapping up the session,
offer \`horizon session-end --harness zcode --session $sid\` — with a one-line
--summary of what the session did if they give one, none if they don't (the
record then carries summary: null; one is never invented). If they decline,
let it go."
fi

jq -cn --arg text "$text" '{additionalContext: $text}' 2>/dev/null || exit 0
exit 0
