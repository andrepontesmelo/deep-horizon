{
  "name": "deep-horizon",
  "version": "0.2.0",
  "description": "Deep Horizon CLI core: a deterministic, human-authored horizon (open gaps + session log) shared across agent harnesses.",
  "license": "MIT",
  "author": "Andre Melo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrepontesmelo/deep-horizon.git"
  },
  "homepage": "https://github.com/andrepontesmelo/deep-horizon#readme",
  "bugs": {
    "url": "https://github.com/andrepontesmelo/deep-horizon"
  },
  "keywords": [
    "ai",
    "agent",
    "agents",
    "cli",
    "context",
    "harness",
    "session-log",
    "claude-code",
    "opencode",
    "pi",
    "hermes"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "horizon": "bin/horizon.js",
    "horizon-inject": "bin/horizon-inject.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./dsh": {
      "types": "./src/adapters/dsh.ts",
      "default": "./dist/adapters/dsh.js"
    },
    "./opencode": "./src/adapters/opencode.ts",
    "./pi": "./src/adapters/pi.ts",
    "./texts": "./src/texts.ts"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "adapters/hermes/__init__.py",
    "adapters/hermes/deep_horizon.py",
    "adapters/hermes/plugin.yaml",
    "adapters/zcode/session-start",
    "adapters/zcode/pre-execute",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/adapters/pi.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-dist.cjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm test",
    "sync:hermes": "bash scripts/sync-hermes-adapter.sh"
  }
}
