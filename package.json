{
  "bin": { "horizon": "bin/horizon.js", "horizon-inject": "bin/horizon-inject.js" },
  "description": "Horizon Line CLI core: a deterministic, human-authored horizon (open gaps + session log) shared across agent harnesses.",
  "engines": { "node": ">=22.23" },
  "exports": {
    ".": "./src/index.ts",
    "./dsh": "./src/adapters/dsh.ts",
    "./opencode": "./src/adapters/opencode.ts",
    "./pi": "./src/adapters/pi.ts",
    "./texts": "./src/texts.ts"
  },
  "files": ["bin", "dist", "src", "adapters"],
  "pi": { "extensions": ["./src/adapters/pi.ts"] },
  "license": "MIT",
  "name": "horizon-line",
  "scripts": {
    "build": "node scripts/build-dist.cjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "type": "module",
  "version": "0.1.0"
}
